@using ResumeProject.Models
@model TblSolution


@{
    ViewBag.Title = "UpdateSolution";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Çözüm Güncelleme Sayfası</h2>

<form method="post">
    @Html.HiddenFor(x=>x.SolutionID)
    <label>Çözüm Adı</label>
    @Html.TextBoxFor(x=>x.SolutionName, new {@class="form-control"})
    <br />
    <label>Çözüm Resim Yolu</label>
    @Html.TextBoxFor(x=>x.ImageUrl, new {@class="form-control"})
    <br />

    <button class="btn btn-success">Kaydet</button>
</form>