
@{
    ViewBag.Title = "AddService";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Hizmet Ekleme Sayfası</h2>

<form method="post">
    <label>Hizmet Başlığı</label>
    <input type="text" class="form-control" name="ServiceTitle" />
    <br />
    <label>Hizmet Açıklaması</label>
    <input type="text" class="form-control" name="ServiceDescription" />
    <br />
    <label>Hizmet Icon</label>
    <input type="text" class="form-control" name="ServiceIcon" />
    <br />
    <button class="btn btn-outline-primary">Kaydet</button>
</form>



