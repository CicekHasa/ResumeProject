
@{
    ViewBag.Title = "AddFooterInfo";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Add Footer Info Page</h2>

<form method="post">
    <label>Footer Phone</label>
    <input type="text" class="form-control" name="FooterTel" />
    <br />
