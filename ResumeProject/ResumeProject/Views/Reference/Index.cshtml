@using ResumeProject.Models
@model  List<TblReferences>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Referanslar listesi</h2>

<table class="table table-bordered">
    <tr>
        <td>#</td>
        <td>Referans Adı</td>
        <td>Referans Mesleği</td>
        <td>Referans Açıklaması</td>
        <td>Sil</td>
        <td>Güncelle</td>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ReferenceId</td>
            <td>@item.Name</td>
            <td>@item.Job</td>
            <td>@item.Description</td>
            <td><a href="/Reference/DeleteReference/@item.ReferenceId" class="btn btn-danger">Sil</a></td>
            <td><a href="/Reference/UpdateReference/@item.ReferenceId" class="btn btn-primary">Güncelle</a></td>
        </tr>
    }
</table>

<a href="/Reference/AddReference" class="btn btn-outline-success">Yeni Referans Ekle</a>

