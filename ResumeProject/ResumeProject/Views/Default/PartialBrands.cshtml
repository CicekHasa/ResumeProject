@using ResumeProject.Models
@model List<TblBrands>
<section class="w3l-brands py-md-5 py-4">
    <div class="container py-lg-2">
        <div class="align-items-center">
            <div id="owl-demo" class="owl-carousel owl-theme">
                @foreach (var brand in Model)
                {
                    <div class="item">
                        <img src="@Url.Content(brand.BrandImagePath)" class="img-fluid" alt="Brand">
                        @*<img src="~/Content/starter/starter/assets/images/logo1.png" class="img-fluid" alt="Brand">*@
                    </div>
                }
            </div>
        </div>
    </div>
</section>
